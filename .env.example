# Non-sensitive settings only. Never put tokens or keys in this file:
# connector credentials live in the operating system's keyring.

# Scrinium's data directory. Default: ~/.local/share/scrinium on Linux,
# ~/Library/Application Support/scrinium on macOS and %LOCALAPPDATA%\scrinium on Windows.
# It must be on a disk that honours permissions: ext4 or APFS; on Windows, NTFS (Scrinium sets
# the ACL so only your account, SYSTEM and Administrators get in). FAT and exFAT do not work.
# SCRINIUM_DATA_DIR=

# Local port. The address is always 127.0.0.1 and cannot be changed.
# SCRINIUM_PORT=47615

# Local models: llama (default; Scrinium starts llama-server with what
# `scrinium tools install` downloads) or ollama (an Ollama already running on this machine).
# SCRINIUM_MODEL_PROVIDER=llama

# Ollama only. Only an address on this machine is accepted.
# Default: Scrinium's own Ollama (make ollama, models in .models/).
# SCRINIUM_OLLAMA_URL=http://127.0.0.1:11435
# SCRINIUM_EMBEDDING_MODEL=qwen3-embedding:0.6b
# SCRINIUM_LLM_MODEL=qwen3:4b-instruct
